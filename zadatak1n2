import functools
import logging

logging.basicConfig(level=logging.INFO)

def log_execution(func):
 @functools.wraps(func)
 def wrapper(*args, **kwargs):

 logging.info(
 f"Ulazak u funkciju {func.__name__}, "
 f"args: {args}, kwargs: {kwargs}"
 )

 result = func(*args, **kwargs)

 logging.info(
 f"Izlazak iz funkcije {func.__name__}, "
 f"povratna vrednost: {result}"
 )

 return result

 return wrapper


@log_execution
def saberi(a, b):
 return a + b


rezultat = saberi(5, 3)
print("Rezultat:", rezultat)
