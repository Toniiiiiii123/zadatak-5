import socket

HOST = 'localhost'
PORT = 65432

with open('data.txt', 'r') as file:
    data = file.read()

with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
    s.bind((HOST, PORT))
    s.listen()

    print("Server 1 radi...")

    conn, addr = s.accept()

    with conn:
        print("Povezan:", addr)
        conn.sendall(data.encode())

